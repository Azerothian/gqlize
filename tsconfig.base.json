{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "Preserve",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,
    "strict": false,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "importHelpers": true,
    "types": ["@types/node"],
    "sourceMap": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    "paths": {
      "@azerothian/gqlize-shared": ["./packages/gqlize-shared/src/index.ts"],
      "@azerothian/gqlize-shared/*": ["./packages/gqlize-shared/src/*"],
      "@azerothian/graphql-types": ["./packages/graphql-types/src/index.ts"],
      "@azerothian/graphql-types/*": ["./packages/graphql-types/src/*"],
      "@azerothian/gqlize": ["./packages/gqlize/src/index.ts"],
      "@azerothian/gqlize/*": ["./packages/gqlize/src/*"],
      "@azerothian/ormize": ["./packages/ormize/src/index.ts"],
      "@azerothian/ormize/*": ["./packages/ormize/src/*"],
      "@azerothian/ormize-adapter-sequelize": ["./packages/ormize-adapter-sequelize/src/index.ts"],
      "@azerothian/ormize-adapter-sequelize/*": ["./packages/ormize-adapter-sequelize/src/*"]
    }
  }
}
