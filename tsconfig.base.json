{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "Preserve",
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "importHelpers": true,
    "types": ["@types/node"],
    "sourceMap": true,

    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": true,

    "paths": {
      "@azerothian/graphql-types": ["./packages/graphql-types/src/index.ts"],
      "@azerothian/graphql-types/*": ["./packages/graphql-types/src/*"],
      "@azerothian/gqlize": ["./packages/gqlize/src/index.ts"],
      "@azerothian/gqlize/*": ["./packages/gqlize/src/*"],
      "@azerothian/ormize": ["./packages/ormize/src/index.ts"],
      "@azerothian/ormize/*": ["./packages/ormize/src/*"],
      "@azerothian/ormize-adapter-sequelize": ["./packages/ormize-adapter-sequelize/src/index.ts"],
      "@azerothian/ormize-adapter-sequelize/*": ["./packages/ormize-adapter-sequelize/src/*"],
      "@azerothian/utilize": ["./packages/utilize/src/index.ts"],
      "@azerothian/utilize/*": ["./packages/utilize/src/*"],
      "@azerothian/ormize-zod4": ["./packages/ormize-zod4/src/index.ts"],
      "@azerothian/ormize-zod4/*": ["./packages/ormize-zod4/src/*"],
      "@azerothian/nestize": ["./packages/nestize/src/index.ts"],
      "@azerothian/nestize/*": ["./packages/nestize/src/*"],
      "@azerothian/temporalize": ["./packages/temporalize/src/index.ts"],
      "@azerothian/temporalize/*": ["./packages/temporalize/src/*"]
    }
  }
}
