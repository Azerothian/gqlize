coverage/
*.tsbuildinfo

# build outputs
/packages/*/publish/
/packages/*/lib/
/packages/*/cjs/
/packages/*/.tsbuild/

# Generated gqlize schema artifacts. Committed for the two examples whose pair
# is a reviewable build output that CI diffs (the "Schema drift" steps in
# .github/workflows/ci.yml); rebuild with `pnpm schema:build`. Ignored for every
# other example until one opts in the same way.
/examples/*/generated/**
!/examples/gqlize-basic/generated/**
!/examples/mikro-orm-basic/generated/**

