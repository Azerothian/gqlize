{
  "extends": ["./tsconfig.json", "../../tsconfig.test.base.json"],
  "include": ["src/**/*", "__tests__/**/*"],
  // `__tests__/types` is the `tsc -p tsconfig.test-d.json` program, which runs
  // the same files under `strict: true`. Checking them twice under two
  // different strictness settings makes every `@ts-expect-error` in there
  // unsatisfiable in one pass or the other.
  "exclude": ["node_modules", ".tsbuild", "lib", "cjs", "publish", "__tests__/types"]
}
