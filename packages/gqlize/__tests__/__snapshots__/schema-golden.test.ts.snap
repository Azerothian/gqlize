    before: String

    """
    If provided the results will be the first \${amount} of records from provided cursor, if a cursor is not provided  the results will be the last \${amount} of records.
    """
    last: Int

    """
    When true and this is a nested relationship, the relation is eager-loaded as an INNER JOIN so parents without a matching related row are excluded.
