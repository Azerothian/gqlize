{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    // Publish-time declaration emit: resolve sibling workspace packages from
    // their built declarations (turbo `^build` builds them first) rather than
    // source, so their .ts files are not pulled under this package's rootDir.
    "paths": {
      "@azerothian/ormize": ["../ormize/publish/types/index.d.ts"],
      "@azerothian/ormize/*": ["../ormize/publish/types/*"],
      "@azerothian/utilize": ["../utilize/publish/types/index.d.ts"],
      "@azerothian/utilize/*": ["../utilize/publish/types/*"],
      "@azerothian/graphql-types": ["../graphql-types/publish/types/index.d.ts"],
      "@azerothian/graphql-types/*": ["../graphql-types/publish/types/*"]
    }
  }
}
