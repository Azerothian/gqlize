{
  "name": "@azerothian/gqlize",
  "version": "6.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "A relational databinder for generating graphql schemas to connect and work with multi data sources",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azerothian/gqlize.git",
    "directory": "packages/gqlize"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "serve": "tsx ./__tests__/helper/express.ts",
    "print-schema": "tsx ./src/cli/index.ts print -c ./__tests__/helper/gqlize.config.ts",
    "bench:artifact": "tsx ./scripts/bench-artifact.ts",
    "watch": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc -p tsconfig.test.json",
    "package:yalc": "pnpm run build && cd publish && yalc publish",
    "package:npm": "pnpm run build && cd publish && npm publish",
    "build": "rm -Rf ./publish || true; mkdir ./publish && run-p build:*",
    "build:readme": "cp ./README.md ./publish/README.md",
    "build:src": "copyfiles -u 1 \"src/**/*\" publish/src",
    "build:package": "tsx ../../scripts/build/prepare-package.ts --bin gqlize=./cjs/cli/index.js",
    "build:main": "tsx ../../scripts/build/swc-build.ts esm && tsx ../../scripts/build/fix-esm-extensions.ts",
    "build:types": "tsc -p tsconfig.types.json --outDir publish/types",
    "build:cjs": "tsx ../../scripts/build/swc-build.ts cjs"
  },
  "author": "VostroNet",
  "license": "MIT",
  "homepage": "https://github.com/azerothian/gqlize",
  "bugs": {
    "url": "https://github.com/azerothian/gqlize/issues"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@electric-sql/pglite-socket": "catalog:",
    "@jest/globals": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "copyfiles": "catalog:",
    "del": "catalog:",
    "graphql": "17.0.2",
    "graphql-relay": "^0.10.2",
    "graphql-yoga": "catalog:",
    "jest": "catalog:",
    "npm-run-all2": "catalog:",
    "pg": "catalog:",
    "pg-hstore": "catalog:",
    "sequelize": "^6.37.7",
    "sqlite3": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "uuid": "catalog:"
  },
  "peerDependencies": {
    "graphql": "^17.0.0",
    "graphql-relay": "^0.10.0"
  },
  "dependencies": {
    "@azerothian/ormize": "workspace:*",
    "@azerothian/utilize": "workspace:*",
    "@azerothian/graphql-types": "workspace:^",
    "@vostro/object-visit": "^1.1.0"
  }
}
