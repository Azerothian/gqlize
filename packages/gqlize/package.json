{
  "name": "@azerothian/gqlize",
  "version": "6.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "A relational databinder for generating graphql schemas to connect and work with multi data sources",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azerothian/gqlize.git",
    "directory": "packages/gqlize"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "serve": "tsx ./__tests__/helper/express.ts",
    "print-schema": "tsx ./src/cli/index.ts print -c ./__tests__/helper/gqlize.config.ts",
    "bench:artifact": "tsx ./scripts/bench-artifact.ts",
    "watch": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc -p tsconfig.test.json",
    "package:yalc": "pnpm run build && cd publish && yalc publish",
    "package:npm": "pnpm run build && cd publish && npm publish",
    "build": "rm -Rf ./publish || true; mkdir ./publish && run-p build:*",
    "build:readme": "cp ./README.md ./publish/README.md",
    "build:src": "copyfiles -u 1 \"src/**/*\" publish/src",
    "build:package": "tsx ./scripts/prepare-package.ts",
    "build:main": "swc src --out-dir publish/lib --out-file-extension mjs --strip-leading-paths -s --ignore \"**/*.d.ts\" && tsx ./scripts/fix-esm-extensions.ts",
    "build:types": "tsc -p tsconfig.types.json --outDir publish/types",
    "build:cjs": "swc src --out-dir publish/cjs --config-file=.swcrc-cjs --strip-leading-paths -s --ignore \"**/*.d.ts\""
  },
  "author": "VostroNet",
  "license": "MIT",
  "homepage": "https://github.com/azerothian/gqlize",
  "bugs": {
    "url": "https://github.com/azerothian/gqlize/issues"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@jest/globals": "^30.4.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@tsconfig/node20": "^20.1.5",
    "@tsconfig/recommended": "^1.0.8",
    "@types/debug": "^4.1.12",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@types/pluralize": "^0.0.33",
    "copyfiles": "^2.4.1",
    "deep-freeze": "0.0.1",
    "del": "^8.0.1",
    "expect": "^30.4.1",
    "graphql": "17.0.2",
    "graphql-relay": "^0.10.2",
    "graphql-subscriptions": "^3.0.0",
    "graphql-yoga": "^5.21.2",
    "jest": "^30.4.2",
    "jest-cli": "^30.4.2",
    "node-notifier": "^10.0.1",
    "npm-run-all2": "^9.0.2",
    "pg": "^8.22.0",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "source-map-support": "^0.5.21",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2",
    "uuid": "^14.0.1"
  },
  "peerDependencies": {
    "graphql": "^17.0.0",
    "graphql-relay": "^0.10.0"
  },
  "dependencies": {
    "@azerothian/ormize": "workspace:*",
    "@azerothian/utilize": "workspace:*",
    "@azerothian/graphql-types": "workspace:^",
    "@vostro/object-visit": "^1.1.0",
    "deepmerge": "^4.3.1",
    "pluralize": "^8.0.0"
  }
}
