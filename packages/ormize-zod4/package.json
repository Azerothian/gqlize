{
  "name": "@azerothian/ormize-zod4",
  "version": "6.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "Generate Zod v4 validation schemas (entity / create / update) from an @azerothian/ormize instance, honoring the same permission rules as gqlize",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azerothian/gqlize.git",
    "directory": "packages/ormize-zod4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "cjs/index.js",
  "module": "lib/index.mjs",
  "types": "types/index.d.ts",
  "scripts": {
    "watch": "tsc --watch",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.test.json",
    "package:yalc": "pnpm run build && cd publish && yalc publish",
    "package:npm": "pnpm run build && cd publish && npm publish",
    "build": "rm -Rf ./publish || true; mkdir ./publish && run-p build:*",
    "build:readme": "cp ./README.md ./publish/README.md",
    "build:src": "copyfiles -u 1 \"src/**/*\" publish/src",
    "build:package": "tsx ../../scripts/build/prepare-package.ts",
    "build:main": "tsx ../../scripts/build/swc-build.ts esm && tsx ../../scripts/build/fix-esm-extensions.ts",
    "build:types": "tsc -p tsconfig.types.json --outDir publish/types",
    "build:cjs": "tsx ../../scripts/build/swc-build.ts cjs"
  },
  "author": "VostroNet",
  "license": "MIT",
  "homepage": "https://github.com/azerothian/gqlize",
  "bugs": {
    "url": "https://github.com/azerothian/gqlize/issues"
  },
  "dependencies": {
    "@azerothian/utilize": "workspace:*",
    "zod": "^4.0.0"
  },
  "peerDependencies": {
    "@azerothian/ormize": "^6.0.0"
  },
  "devDependencies": {
    "@azerothian/ormize": "workspace:*",
    "@azerothian/ormize-adapter-sequelize": "workspace:*",
    "@jest/globals": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "copyfiles": "catalog:",
    "jest": "catalog:",
    "npm-run-all2": "catalog:",
    "sequelize": "^6.37.7",
    "sqlite3": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  }
}
