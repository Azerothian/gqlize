{
  "name": "@azerothian/ormize",
  "version": "6.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "A relational data-binder / ORM manager for multi data sources (the GraphQL-free backend of gqlize)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azerothian/gqlize.git",
    "directory": "packages/ormize"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "watch": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc -p tsconfig.test.json",
    "package:yalc": "pnpm run build && cd publish && yalc publish",
    "package:npm": "pnpm run build && cd publish && npm publish",
    "build": "rm -Rf ./publish || true; mkdir ./publish && run-p build:*",
    "build:readme": "cp ./README.md ./publish/README.md",
    "build:src": "copyfiles -u 1 \"src/**/*\" publish/src",
    "build:package": "tsx ../../scripts/build/prepare-package.ts",
    "build:main": "swc src --out-dir publish/lib --out-file-extension mjs --strip-leading-paths -s --ignore \"**/*.d.ts\" && tsx ../../scripts/build/fix-esm-extensions.ts",
    "build:types": "tsc -p tsconfig.types.json --outDir publish/types",
    "build:cjs": "swc src --out-dir publish/cjs --config-file=.swcrc-cjs --strip-leading-paths -s --ignore \"**/*.d.ts\""
  },
  "author": "VostroNet",
  "license": "MIT",
  "homepage": "https://github.com/azerothian/gqlize",
  "bugs": {
    "url": "https://github.com/azerothian/gqlize/issues"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.1.1",
    "@types/pluralize": "^0.0.33",
    "copyfiles": "^2.4.1",
    "graphql": "17.0.2",
    "graphql-relay": "^0.10.2",
    "jest": "^30.4.2",
    "npm-run-all2": "^9.0.2",
    "sequelize": "^6.37.7",
    "sqlite3": "^6.0.1",
    "tsx": "^4.19.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@azerothian/utilize": "workspace:*",
    "pluralize": "^8.0.0"
  }
}
