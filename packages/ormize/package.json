{
  "name": "@azerothian/ormize",
  "version": "6.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "A relational data-binder / ORM manager for multi data sources (the GraphQL-free backend of gqlize)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azerothian/gqlize.git",
    "directory": "packages/ormize"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "watch": "tsc --watch",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc -p tsconfig.test.json",
    "package:yalc": "pnpm run build && cd publish && yalc publish",
    "package:npm": "pnpm run build && cd publish && npm publish",
    "build": "rm -Rf ./publish || true; mkdir ./publish && run-p build:*",
    "build:readme": "cp ./README.md ./publish/README.md",
    "build:src": "copyfiles -u 1 \"src/**/*\" publish/src",
    "build:package": "tsx ../../scripts/build/prepare-package.ts",
    "build:main": "tsx ../../scripts/build/swc-build.ts esm && tsx ../../scripts/build/fix-esm-extensions.ts",
    "build:types": "tsc -p tsconfig.types.json --outDir publish/types",
    "build:cjs": "tsx ../../scripts/build/swc-build.ts cjs"
  },
  "author": "VostroNet",
  "license": "MIT",
  "homepage": "https://github.com/azerothian/gqlize",
  "bugs": {
    "url": "https://github.com/azerothian/gqlize/issues"
  },
  "devDependencies": {
    "@azerothian/test-fixtures": "workspace:*",
    "@jest/globals": "catalog:",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "@types/pluralize": "catalog:",
    "copyfiles": "catalog:",
    "graphql": "17.0.2",
    "graphql-relay": "^0.10.2",
    "jest": "catalog:",
    "npm-run-all2": "catalog:",
    "sequelize": "^6.37.7",
    "sqlite3": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@azerothian/utilize": "workspace:*",
    "pluralize": "^8.0.0"
  }
}
