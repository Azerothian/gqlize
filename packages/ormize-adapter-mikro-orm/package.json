{
  "name": "@azerothian/ormize-adapter-mikro-orm",
  "version": "6.0.0",
  "engines": {
    "node": ">=24"
  },
  "description": "MikroORM adapter for the data binding library - ormize/gqlize. Registers an existing MikroORM instance: entities are discovered from its own metadata, no ormize definitions to author.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azerothian/gqlize.git",
    "directory": "packages/ormize-adapter-mikro-orm"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "watch": "tsc --watch",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.test-d.json",
    "package:yalc": "pnpm run build && cd publish && yalc publish",
    "package:npm": "pnpm run build && cd publish && npm publish",
    "build": "rm -Rf ./publish || true; mkdir ./publish && run-p build:*",
    "build:readme": "cp ./README.md ./publish/README.md",
    "build:src": "copyfiles -u 1 \"src/**/*\" publish/src",
    "build:package": "tsx ../../scripts/build/prepare-package.ts",
    "build:main": "tsx ../../scripts/build/swc-build.ts esm && tsx ../../scripts/build/fix-esm-extensions.ts",
    "build:types": "tsc -p tsconfig.types.json --outDir publish/types",
    "build:cjs": "tsx ../../scripts/build/swc-build.ts cjs"
  },
  "author": "VostroNet",
  "license": "MIT",
  "homepage": "https://github.com/azerothian/ormize-adapter-mikro-orm",
  "bugs": {
    "url": "https://github.com/azerothian/ormize-adapter-mikro-orm/issues"
  },
  "devDependencies": {
    "@azerothian/gqlize": "workspace:*",
    "@azerothian/ormize": "workspace:*",
    "@azerothian/ormize-adapter-sequelize": "workspace:*",
    "@jest/globals": "catalog:",
    "@mikro-orm/core": "^7.2.1",
    "@mikro-orm/sqlite": "^7.2.1",
    "@swc/cli": "catalog:",
    "@swc/core": "catalog:",
    "@swc/jest": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "copyfiles": "catalog:",
    "graphql": "17.0.2",
    "graphql-relay": "^0.10.2",
    "jest": "catalog:",
    "npm-run-all2": "catalog:",
    "sequelize": "^6.37.7",
    "sqlite3": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:"
  },
  "peerDependencies": {
    "@azerothian/gqlize": "^6.0.0",
    "@azerothian/ormize": "^6.0.0",
    "@mikro-orm/core": "^6.0.0 || ^7.0.0",
    "graphql": "^17.0.0"
  },
  "dependencies": {
    "@azerothian/utilize": "workspace:*",
    "@azerothian/graphql-types": "workspace:*"
  }
}
