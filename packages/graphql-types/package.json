{
  "name": "@azerothian/graphql-types",
  "version": "6.0.0",
  "description": "Custom GraphQL scalar types (JSON, Date, BigInt, Float, IP, Upload) and a query-type helper used by gqlize",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Azerothian/gqlize.git",
    "directory": "packages/graphql-types"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "cjs/index.js",
  "module": "lib/index.mjs",
  "types": "types/index.d.ts",
  "scripts": {
    "watch": "tsc --watch",
    "test": "jest",
    "package:yalc": "pnpm run build && cd publish && yalc publish",
    "package:npm": "pnpm run build && cd publish && npm publish",
    "build": "rm -Rf ./publish || true; mkdir ./publish && run-p build:*",
    "build:readme": "cp ./README.md ./publish/README.md",
    "build:src": "copyfiles -u 1 \"src/**/*\" publish/src",
    "build:package": "tsx ./scripts/prepare-package.ts",
    "build:main": "swc src --out-dir publish/lib --out-file-extension mjs --strip-leading-paths -s --ignore \"**/*.d.ts\" && tsx ./scripts/fix-esm-extensions.ts",
    "build:types": "tsc -p tsconfig.types.json --outDir publish/types",
    "build:cjs": "swc src --out-dir publish/cjs --config-file=.swcrc-cjs --strip-leading-paths -s --ignore \"**/*.d.ts\""
  },
  "author": "VostroNet",
  "license": "MIT",
  "homepage": "https://github.com/azerothian/gqlize",
  "bugs": {
    "url": "https://github.com/azerothian/gqlize/issues"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.11.24",
    "@swc/jest": "^0.2.38",
    "@tsconfig/node20": "^20.1.5",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.18",
    "copyfiles": "^2.4.1",
    "globby": "^14.1.0",
    "graphql": "16.8.1",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "npm-run-all2": "^6.2.6",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "graphql": "^16.8.1"
  }
}
