{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "outDir": "./lib",
    "declaration": true,
    "declarationMap": false,
    "emitDeclarationOnly": true,
    "paths": {
      "@azerothian/ormize": ["../ormize/publish/types/index.d.ts"],
      "@azerothian/ormize/*": ["../ormize/publish/types/*"],
      "@azerothian/ormize-zod4": ["../ormize-zod4/publish/types/index.d.ts"],
      "@azerothian/ormize-zod4/*": ["../ormize-zod4/publish/types/*"],
      "@azerothian/utilize": ["../utilize/publish/types/index.d.ts"],
      "@azerothian/utilize/*": ["../utilize/publish/types/*"]
    }
  }
}
