{
  "name": "@azerothian/example-nestize-rest",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable NestJS REST + Swagger API generated from an ormize instance with @azerothian/nestize.",
  "type": "commonjs",
  "scripts": {
    "start": "node -r @swc-node/register src/main.ts",
    "dev": "node -r @swc-node/register --watch src/main.ts"
  },
  "dependencies": {
    "@azerothian/nestize": "workspace:*",
    "@azerothian/ormize": "workspace:*",
    "@azerothian/ormize-adapter-sequelize": "workspace:*",
    "@azerothian/ormize-zod4": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0",
    "sequelize": "^6.37.7",
    "sqlite3": "^6.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.10",
    "@swc/core": "^1.15.43",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.3"
  }
}
