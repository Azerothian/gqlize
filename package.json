{
  "name": "gqlize-monorepo",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "tsc -b",
    "watch": "turbo run watch"
  },
  "devDependencies": {
    "turbo": "^2.10.4",
    "typescript": "^5.8.3"
  },
  "pnpm": {
    "overrides": {
      "graphql": "17.0.2",
      "unicorn-magic": "0.2.0"
    },
    "patchedDependencies": {
      "graphql@17.0.2": "patches/graphql@17.0.2.patch"
    },
    "peerDependencyRules": {
      "allowedVersions": {
        "graphql-relay>graphql": "17"
      }
    }
  }
}
